{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "alter",
      "größe",
      "geschlecht",
      "charakter",
      "hunde_nummer",
      "text_hund",
      "text_zuhause",
      "notfall"
    ],
    "properties": {
      "name": { "type": "string" },
      "alter": {
        "type": "number",
        "minimum": 1.2,
        "maximum": 12.2099,
        "description": "Alter im Format MM.YYYY als Nummer"
      },
      "größe": { "type": "string", "enum": ["Klein", "Mittelgroß", "Groß"] },
      "geschlecht": { "type": "string", "enum": ["Männlich", "Weiblich"] },
      "charakter": { "type": "string" },
      "hunde_nummer": { "type": "string" },
      "text_hund": { "type": "string" },
      "text_zuhause": { "type": "string" },
      "notfall": { "type": "boolean" }
    }
  }
}
