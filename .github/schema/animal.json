{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "größe",
      "geschlecht",
      "charakter",
      "hunde_nummer",
      "text_hund",
      "text_zuhause"
    ],
    "properties": {
      "name": { "type": "string" },
      "größe": { "type": "string", "enum": ["Klein", "Mittelgroß", "Groß"] },
      "geschlecht": { "type": "string", "enum": ["Männlich", "Weiblich"] },
      "charakter": { "type": "string" },
      "hunde_nummer": { "type": "number" },
      "text_hund": { "type": "string" },
      "text_zuhause": { "type": "string" },
      "notfall": { "type": "boolean" }
    },
    "additionalProperties": true
  }
}
