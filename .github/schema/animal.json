{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "alter",
      "größe",
      "geschlecht",
      "charakter",
      "hunde_nummer",
      "text_hund",
      "text_zuhause",
      "notfall"
    ],
    "properties": {
      "name": { "type": "string" },
      "alter": {
        "type": "number",
        "pattern": "^(0[1-9]|1[0-2])\\.20[0-9]{2}$",
        "description": "Alter im Format MM.YYYY als Zahl, führende Null für Monate 01-09"
      },
      "größe": { "type": "string", "enum": ["Klein", "Mittelgroß", "Groß"] },
      "geschlecht": { "type": "string", "enum": ["Männlich", "Weiblich"] },
      "charakter": { "type": "string" },
      "hunde_nummer": { "type": "string" },
      "text_hund": { "type": "string" },
      "text_zuhause": { "type": "string" },
      "notfall": { "type": "boolean" }
    }
  }
}
